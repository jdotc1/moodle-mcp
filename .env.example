# Placeholders only. Copy to .env (git-ignored) and fill in. Never commit real values.

# ---- local (stdio) mode: tokens are normally stored by `moodle-academic-mcp configure` (keyring / 0600 file).
# Optional override per profile+service:  MOODLE_TOKEN_<PROFILE>_<SERVICE>
# MOODLE_TOKEN_UFSC_MOBILE=<paste token here>
# MOODLE_TOKEN_UFSC_ATTENDANCE=<paste token here>
# MAMCP_UPLOAD_ROOTS=/home/you/work:/tmp        # folders the server may upload files from (default: cwd + tmp)

# ---- hosted (Streamable HTTP) mode
MAMCP_PROFILES_FILE=./deploy/profiles.toml      # institutions served by this instance (see docs/auth.md)
MAMCP_DATABASE_URL=postgresql+asyncpg://mamcp:CHANGE_ME@db:5432/mamcp
MAMCP_ENCRYPTION_KEY=                           # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAMCP_PUBLIC_URL=https://mcp.example.org        # public https origin (no trailing slash)
MAMCP_ARTIFACT_DIR=/data/artifacts

# production auth (existing OAuth2/OIDC provider)
MAMCP_AUTH_MODE=oidc
MAMCP_OIDC_ISSUER=https://idp.example.org/realms/mamcp
MAMCP_OIDC_AUDIENCE=https://mcp.example.org/mcp
# MAMCP_OIDC_JWKS_URL=                          # default: <issuer>/.well-known/jwks.json
# MAMCP_ONBOARDING_CLIENT_ID=                   # public client (PKCE) for the onboarding page
# MAMCP_OIDC_AUTHORIZE_URL= / MAMCP_OIDC_TOKEN_URL=

# development auth only (never in production)
# MAMCP_AUTH_MODE=dev
# MAMCP_ALLOW_DEV_AUTH=1
